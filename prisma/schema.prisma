// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model conec {
  id              Int         @id @default(autoincrement())
  access_token    String 
  refresh_token   String
}

model login {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  admin    Boolean  @default(false)
  role     String
  unity    String[]

  created_at                       DateTime  @default(now())
  updated_at                       DateTime  @updatedAt 
}
////////////////////
model registers {
  //intrínseco
  id                    String   @id  @default(uuid())
  name                  String
  owner                 String

  //independentes
  // 1:T
  assinaturaContratoStatus         String  @default("pendente")
  taxaMatriculaStatus              String  @default("pendente")
  pagamentoPrimeiraParcelaStatus   String  @default("pendente")
  materialDidaticoStatus           String  @default("pendente")
  primeiraAulaStatus               String  @default("pendente")
  comissaoStatus                   String  @default("pendente")
  aprovacaoADM                     String  @default("pendente")
  aprovacaoDirecao                 String  @default("pendente")

  // 2:T
  dataMatricula                    String  @default("")
  dataValidacao                    String  @default("")
  dataComissionamento              String  @default("")
  diretorResponsavel               String  @default("")
  admResponsavel                   String  @default("")
  dataPagamentoTaxaMatricula       String  @default("")
  dataPagamentoPrimeiraParcela     String  @default("")
  dataPagamentoMaterialDidatico    String  @default("")
  observacao          Json[]

  //campos personalizados
  customFields                     Json

  //config
  created_at                       DateTime  @default(now())
  updated_at                       DateTime  @updatedAt 

  //relações
  historic   logHistoric[]
}

model logHistoric {
  id             String    @id @default(uuid())
  responsible    String
  information    Json

  registerId     String
  register       registers @relation(fields: [registerId], references: [id])

  created_at     DateTime  @default(now())
  updated_at                       DateTime  @updatedAt 
}
////////////////////



model unities {
  id         String    @id @default(uuid())
  name       String
  requests   requests[]

  created_at                       DateTime  @default(now())
  updated_at                       DateTime  @updatedAt 
}

model historic {
  id             String    @id @default(uuid())
  responsible    String
  date           DateTime  @default(now())
  information    Json
}

enum situation {
  REVISAR
  REVISADO
  ENVIADO
  CHEGOU
  DISPONIVEL
  ENTREGUE
  CANCELADO
}
enum logisticType {
  ENCOMENDA
  REPOSICAO
}

model files {
  id            String    @id  @default(cuid())
  name          String
  key           String
  contentType   String
  contract      String
  created_at                       DateTime  @default(now())
  updated_at                       DateTime  @updatedAt 
}

enum TYPE {
String
Number
Date 
Select
MultiSelect
}

enum CATEGORY {
StatusMatricula
Observacoes
Contrato 
Financeiro
InformacoesAlunoEResponsavel
Pedagogico
Outros
}

model customFields {
  id          String   @id  @default(uuid())
  
  name        String
  type        String
  options     String[]  

  order       Int

  category    CATEGORY @default(Outros)

  required    Boolean  @default(false)

  created_at                       DateTime  @default(now())
  updated_at                       DateTime  @updatedAt 
}

enum descountType {
  Percentage
  Value
  Exchange
}

enum destiny {
  Parcel
  Material
  Tax
}

model campaign {
  id                String   @id  @default(cuid())
  name              String
  description       String
  affectedParcels   Int           @default(1)
  value             Int
  descountType      descountType  @default(Percentage)
  for               destiny
  status            Boolean       @default(true)

  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
}
enum typeInsume {
  Product
  Service
}



model contract {
  id                String   @id  @default(cuid())
  name              String
  text              String

  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
}



model products {
  id                String   @id  @default(cuid())
  name              String
  sku               String
  color             String
  status            Boolean       @default(true)
  price_selling     Float
  price_ticket      Float
  price_card        Float
  price_cash        Float
  price_link        Float
  category          typeInsume 
  rules             billingRules[]

  
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
}

model services {
  id                String   @id  @default(cuid())
  name              String
  sku               String
  color             String
  status            Boolean       @default(true)
  price_selling     Float
  price_ticket      Float
  price_card        Float
  price_cash        Float
  price_link        Float
  category          typeInsume 
  workLoad          String
  course            String
  modality          String
  duration          String        @default("0")
  rules             billingRules[]


  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
}

enum supliersType {
FISICO
JURIDICO
}
model supliers {
  id                String   @id  @default(cuid())
  name              String
  docment           String   @unique
  type              supliersType  @default(JURIDICO)
  contacts          Json
  address           Json

  orders            requests[]


  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
}


model requests {
  id         String   @id  @default(uuid())
  orders     orders[]
  
  suplierID   String
  suplier     supliers  @relation(fields: [suplierID], references: [id])
  
  messageSent  String
  user        String
  codeRequest String

  prevision   Int
  price       Float
  
  unityId     String
  unity       unities @relation(fields: [unityId], references: [id])

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
}


model orders {
  id           String   @id  @default(uuid())
  sku          String
  name         String
  phone        String?
  student      String?
  
  link         String?
  unity        String
  value        Float
  arrived      Boolean     @default(false) // chegada
  arrivingDate DateTime?     // data que foi entregue
  signed       Boolean           @default(false) //assinado
  available    Boolean           @default(true) //disponivel
  delivery     Boolean          @default(false) //entregue
  withdraw     DateTime? // data que foi entregue
  removedBy    String? // quem entregou
  book         String 
  status       situation       @default(REVISAR)
  type         logisticType    @default(ENCOMENDA)

  tags         String[]
  logistic     Json[]
  logs         Json[]
  observations Json[]
  
  requestId    String?
  request      requests?  @relation(fields: [requestId], references: [id])

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

}

enum TriggerMoment   {
BEFORE
AT
AFTER
}

model billingRules {
  id               String   @id  @default(uuid())
  name             String
  description      String
  reminderMethod    Json
  daysToAction     Int
  message          String
  typeTrigger      TriggerMoment  
  category         typeInsume
  productsRelated  products[]
  servicesRelated  services[]  
  status           Boolean    @default(true)

  created_at                       DateTime  @default(now())
  updated_at                       DateTime  @updatedAt 
}