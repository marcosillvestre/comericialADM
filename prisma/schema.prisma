generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model conec {
  id              Int         @id @default(autoincrement())
  access_token    String 
  refresh_token   String
}

model login {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  admin    Boolean  @default(false)
  role     String
  unity    String[]
}
////////////////////
model registers {
  //intrínseco
  id                    String   @id  @default(uuid())
  name                  String
  owner                 String

  //independentes
  // 1:T
  assinaturaContratoStatus         String  @default("pendente")
  taxaMatriculaStatus              String  @default("pendente")
  pagamentoPrimeiraParcelaStatus   String  @default("pendente")
  materialDidaticoStatus           String  @default("pendente")
  primeiraAulaStatus               String  @default("pendente")
  comissaoStatus                   String  @default("pendente")
  aprovacaoADM                     String  @default("pendente")
  aprovacaoDirecao                 String  @default("pendente")

  // 2:T
  dataMatricula                    String  @default("")
  dataValidacao                    String  @default("")
  dataComissionamento              String  @default("")
  diretorResponsavel               String  @default("")
  admResponsavel                   String  @default("")
  dataPagamentoTaxaMatricula       String  @default("")
  dataPagamentoPrimeiraParcela     String  @default("")
  dataPagamentoMaterialDidatico    String  @default("")
  observacao          Json[]

  //campos personalizados
  customFields                     Json

  //config
  created_at                       DateTime  @default(now())
  updated_at                       DateTime  @updatedAt 

  //relações
  historic   logHistoric[]
}

model logHistoric {
  id             String    @id @default(uuid())
  responsible    String
  created_at     DateTime  @default(now())
  information    Json

  registerId     String
  register       registers @relation(fields: [registerId], references: [id])
}
////////////////////

model person {
  // intrínseco
  name                String
  owner               String

  // independem
  aprovacaoADM        String
  ppStatus            String
  tmStatus            String
  mdStatus            String
  responsavelADM      String
  aprovacaoDirecao    String
  diretorResponsavel  String
  comissaoStatus      String
  paStatus            String
  acStatus            String
  // * Status da matricula 
  
  // campos personalizados
  aluno               String
  unidade             String
  contrato            String   @id
  background          String
  classe              String
  subclasse           String
  tmVencimento        String
  tmValor             String
  ppVencimento        String
  mdValor             String
  acFormato           String
  tipoMatricula       String
  tipoComissao        String
  comissaoValor       String
  paDATA              String
  inicioContrato      String
  fimContrato         String
  tel                 String
  email               String
  Valor               Float
  id                  Int
  situMatric          String
  alunoNascimento     String
  cargaHoraria        String
  contratoStatus      String
  dataComissionamento String
  dataMatricula       String
  dataValidacao       String
  formatoAula         String
  horarioFim          String
  horarioInicio       String
  idadeAluno          String
  materialDidatico    String[]
  mdData              String
  mdDesconto          String
  mdFormaPg           String
  mdParcelas          String
  mdVencimento        String
  nivelamento         String
  observacao          Json[]
  ppData              String
  ppDesconto          String
  ppFormaPg           String
  ppParcelas          String
  ppValor             String
  tempoContrato       String
  tipoModalidade      String
  tmData              String
  tmDesconto          String
  tmFormaPg           String
  tmParcelas          String
  dataAC              Json[]
  diaAula             String[]
  professor           String[]
  curso               String
}


model unities {
  id         String    @id @default(uuid())
  name       String
  requests   requests[]
}

model historic {
  id             String    @id @default(uuid())
  responsible    String
  date           DateTime  @default(now())
  information    Json
}

model weekOrder {
  id          String   @id  @default(uuid())
  code        String
  unity       String
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  
  orders      books[]
}
model books {
  id      String   @id  @default(uuid())
  sku    String
  tel    String?
  data    String
  link    String
  nome    String
  aluno    String?
  valor    Float
  chegada    Boolean  @default(false)
  assinado    Boolean  @default(false)
  retiradoPor    String
  dataRetirada    String
  materialDidatico    String
  type     String
  
  orderRelated weekOrder @relation(fields: [orderId], references: [id])
  orderId   String
}

enum situation {
  REVISAR
  REVISADO
  ENVIADO
  CHEGOU
  DISPONIVEL
  ENTREGUE
  CANCELADO
}
enum logisticType {
  ENCOMENDA
  REPOSICAO
}
model order {
  id         String   @id  @default(uuid())
  phone      String?
  student    String?
  
  sku      String
  link     String
  name     String
  unity    String
  value    Float

  arrived          Boolean     @default(false) // chegada
  arrivingDate     String     // data que foi entregue
  
  signed     Boolean           @default(false) //assinado
  available  Boolean           @default(true) //disponivel

  delivery    Boolean          @default(false) //entregue
  withdraw     String // data que foi entregue

  removedBy    String // quem entregou
  book         String 

  status       situation       @default(REVISAR)
  type         logisticType    @default(ENCOMENDA)

  tags         String[]
  logistic     Json[]
  logs         Json[]

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
}




model files {
  id            String    @id  @default(cuid())
  name          String
  key           String
  contentType   String
  contract      String
  createdAt     DateTime  @default(now())
}

enum TYPE {
String
Number
Date 
Select
MultiSelect
}

enum CATEGORY {
StatusMatricula
Observacoes
Contrato 
Financeiro
InformacoesAlunoEResponsavel
Pedagogico
Outros
}

model customFields {
  id          String   @id  @default(uuid())
  
  name        String
  type        String
  options     String[]  

  order       Int

  category    CATEGORY @default(Outros)

  required    Boolean  @default(false)
  created_at  DateTime @default(now())
}

enum descountType {
  Percentage
  Value
  Exchange
}

enum destiny {
  Parcel
  Material
  Tax
}

model campaign {
  id                String   @id  @default(cuid())
  name              String
  description       String
  affectedParcels   Int           @default(1)
  value             Int
  descountType      descountType  @default(Percentage)
  for               destiny
  status            Boolean       @default(true)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
}
enum typeInsume {
  Product
  Service
}



model contract {
  id                String   @id  @default(cuid())
  name              String
  text              String
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
}



model products {
  id                String   @id  @default(cuid())
  name              String
  sku               String
  color             String
  status            Boolean       @default(true)
  price_selling     Float
  price_ticket      Float
  price_card        Float
  price_cash        Float
  price_link        Float
  category          typeInsume 
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
}

model services {
  id                String   @id  @default(cuid())
  name              String
  sku               String
  color             String
  status            Boolean       @default(true)
  price_selling     Float
  price_ticket      Float
  price_card        Float
  price_cash        Float
  price_link        Float
  category          typeInsume 
  workLoad          String
  course            String
  modality          String
  duration          String        @default("0")
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
}

enum supliersType {
FISICO
JURIDICO
}
model supliers {
  id                String   @id  @default(cuid())
  name              String
  docment           String   @unique
  type              supliersType  @default(JURIDICO)
  contacts          Json
  address           Json

  orders            requests[]
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
}


model requests {
  id         String   @id  @default(uuid())
  orders     orders[]
  suplier     supliers  @relation(fields: [suplierID], references: [id])
  messageSent  String
  user        String
  suplierID   String
  codeRequest String
  unityId     String

  prevision   Int
  price       Float
  
  unity       unities @relation(fields: [unityId], references: [id])
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
}


model orders {
  id         String   @id  @default(uuid())
  sku      String
  name     String
  phone      String?
  student    String?
  
  link     String
  unity    String
  value    Float
  arrived          Boolean     @default(false) // chegada
  arrivingDate     DateTime?     // data que foi entregue
  signed     Boolean           @default(false) //assinado
  available  Boolean           @default(true) //disponivel
  delivery    Boolean          @default(false) //entregue
  withdraw     DateTime? // data que foi entregue
  removedBy    String // quem entregou
  book         String 
  status       situation       @default(REVISAR)
  type         logisticType    @default(ENCOMENDA)
  tags            String[]
  logistic        Json[]
  logs            Json[]
  observations    Json[]
  
  request     requests?  @relation(fields: [requestId], references: [id])
  requestId   String?

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

}